&ngrid
!!
Nx = 100                 ! Number of x T points
Ny = 100                 ! Number of y T points
!!
Lx = 1.E6                ! Width of domain in x [m]  1.e6 = 1000 km
Ly = 1.E6                ! Width of domain in y [m]  1.e6 = 1000 km
!!
Tm_d = 21.                       ! Length of the run in days
rfsave = 1                       ! Timestep at which to save fields in hours.
data_name = 'data/nr_2'        ! Name of folder to save
/

&nphysics
!!
D = 1000.               ! Average depth [m]
g = 0.0981             ! gravity parameter
!!
l_coriolis = .TRUE.     ! Introduce rotation
f0 = 0.              ! Coriolis constant
!!
l_betaplane = .TRUE.    ! Do we want to also use beta-plane? 
beta = 2.E-11           ! beta pane value f = f0 + beta*y
l_energy = .FALSE.      ! Do we want to to compute energy?
l_energyij = .FALSE.    ! Do we want to to compute energy   at every time step?
/

&ninitial
!!
h0 = 5.                     ! Amplitude of the perturbation
!!
l_gaussian = .TRUE.         ! Initial condition set as gaussian
l_gaussian_south = .FALSE.   ! move gaussian to south border
Lw = 10.                     ! Width of the gaussian L = Lw*width
!!
l_stepfunction = .FALSE. ! Initial condition set as step function in East - West
/

&nnumerics
!!
rcfl = 0.25             ! CFL criterion
!!
!! Filtering for Leapfrog scheme:
gamma = 0.075           ! Asselin coefficient
/

&nboundaries
!!
l_solidbc = .FALSE.       ! Impose solid boundaries
l_solidbc_south = .FALSE.  ! Impose solid boundaries only in south
!!
l_periodic = .TRUE.     ! Impose periodic boundaries
l_up = .TRUE.           ! Periodic in E-W
l_vp = .FALSE.          ! Periodic in N-S
!!
l_spongebc = .TRUE.    ! Introduce open conditions
S  = 20                   ! Number of grid points in the sponge 
btype = 1               ! 0 open BC everywhere, 1 open BC N-S, 2 open BC E-W
!!
l_write_uv = .TRUE.     ! Should we output U and V? (H is always writen)
l_write_domain = .TRUE. ! If FALSE the netcdf will include the sponge
l_alpha = .FALSE.       ! Save the sponge
/
